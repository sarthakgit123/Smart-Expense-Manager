# Copy to .env and fill in real values. Never commit .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
TIME_ZONE=Asia/Kolkata

# --- Database (leave blank to use local SQLite) ---
DATABASE_URL=
# Set USE_SQLITE=True (e.g. `$env:USE_SQLITE="True"` in PowerShell) to force local SQLite
USE_SQLITE=False
DB_SSL_REQUIRE=True

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Brevo SMTP example) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Telegram / n8n integration ---
# Shared secret n8n sends in the X-N8N-Secret header (generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))")
N8N_WEBHOOK_SECRET=
TELEGRAM_LINK_CODE_TTL_MINUTES=10
# Bot username from @BotFather, without the "@" (e.g. SmartExpenseBot)
TELEGRAM_BOT_USERNAME=MySmartExpense2026Bot
